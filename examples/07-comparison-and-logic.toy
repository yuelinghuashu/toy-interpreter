// ============================================================================
// 07 —— 布尔、比较与逻辑
//
// 演示：true / false 是关键字；比较 == != < <= > >= 中，< <= > >= 只接受整数，
//       == 与 != 要求两侧类型相同（字符串、布尔也能比）；逻辑 && || 要求 bool，
//       并且短路：左边能定结果时右边不求值（右边放除零也不会真的算）。
// 运行：go run . examples/07-comparison-and-logic.toy
// ============================================================================

// 比较：结果都是 bool
1 < 2
2 <= 2
1 > 2
2 >= 3
1 == 1
1 != 2
"a" == "a"
true == false

// 逻辑：&& || 的两边都必须是 bool，结果也是 bool
true && true
true && false
false || true
!false
!(1 + 2 < 4)

// 短路：右边含除零，左边已经能定结果，所以右边根本不会求值
false && 1 / 0 > 0
true || 1 / 0 > 0

// 布尔可以存进变量，再参与运算
let inRange = 1 < 5 && 5 <= 10
let isSame = "a" + "b" == "ab"
inRange && isSame
