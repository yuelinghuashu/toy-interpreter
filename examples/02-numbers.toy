// ============================================================================
// 02 —— 整数字面量
//
// 演示：十进制；0x/0X 十六进制；0b/0B 二进制；0o/0O 八进制；
//       数字之间可以用 _ 分隔（前缀后也行，如 0xff_ff、0b1111_0000）；
//       解析成 int64，上限 9223372036854775807；字面量本身不带符号，
//       负数一律写成"一元负号 + 正字面量"。
// 运行：go run . examples/02-numbers.toy
// ============================================================================

let decimal = 123
let decimalSeparated = 1_000_000
let hex = 0x1f
let hexUpper = 0XFF
let hexSeparated = 0xff_ff
let binary = 0b1010
let binarySeparated = 0B1111_0000
let octal = 0o17
let octalUpper = 0O755
let int64Max = 9223372036854775807

// 进制混算：16 + 8 + 2 = 26，再整体取负 = -52
let mixedBases = 0x10 + 0o10 + 0b10
-mixedBases * 2

// 字面量本身没有符号，负号是一元运算
-123
